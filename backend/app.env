DB_URL=postgresql://user:password@localhost:5432/dbname?sslmode=disable
SERVER_ADDR=0.0.0.0:8081
NATS_URL=nats://localhost:4222
TOKEN_SECRET=PROVIDE_SECURE_TOKEN_SECRET_HERE
TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h
AUTH_CACHE_TTL=2m
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REFRESH=10
RATE_LIMIT_SIGNUP=3
MAX_SESSIONS_PER_USER=5
AUDIT_LOG_RETENTION_DAYS=90
JWT_SIGNING_ALGORITHM=HS512
JWT_ISSUER=grc-compil-auth
JWT_AUDIENCE=grc-compil-api
SUPER_ADMIN_ROLE=super_admin
USER_ROLE=user
VERIFICATION_DURATION=24h
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
BCRYPT_COST=12
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=PROVIDE_SMTP_PASSWORD_HERE
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=GRC Compliance System

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:3000

# Security Constants (Centralized)
AUTH_PAYLOAD_KEY=auth_payload
ACCESS_TOKEN_COOKIE=access_token
REFRESH_TOKEN_COOKIE=refresh_token
